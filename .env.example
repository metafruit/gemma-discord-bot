# Discord Bot Token
DISCORD_TOKEN=your_discord_bot_token_here

# Optional: Google AI Studio Gemini API Key for web grounding search and multimodal video/picture parsing
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.8-flash

# Ollama Configuration
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=gemma4:e2b
EMBED_MODEL=embeddinggemma-2
NUM_CTX=24576

# Memory context limits
IMAGE_MEMORY_MAX_CHARS=55000
TEXT_MEMORY_MAX_CHARS=70000

# Optional: Custom Community Member Guidance and Search Exclusions
COMMUNITY_MEMBERS_PROMPT=COMMUNITY MEMBERS: You know your server members...
COMMUNITY_MEMBERS=Member1, Member2, Member3
